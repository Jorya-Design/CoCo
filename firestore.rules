rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function orgMember() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/organizations/coco-co).data.memberEmails;
    }
    function publicRoom(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data.get('orgId', '') == 'coco-co';
    }
    function orgRoomAfter(roomId) {
      return getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.get('orgId', '') == 'coco-co';
    }
    match /organizations/coco-co {
      allow read: if true;
      allow write: if false;
      match /runtime/worker-health {
        allow read: if true;
        allow write: if false;
      }
      match /executionRequests/{requestId} {
        allow read: if orgMember();
        allow create: if orgMember()
          && request.resource.data.keys().hasOnly(['roomId','approvalId','requestedBy','requestedByEmail','status','createdAt'])
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.requestedByEmail == request.auth.token.email.lower()
          && request.resource.data.roomId is string && request.resource.data.roomId.matches('^[a-zA-Z0-9_-]{1,128}$')
          && request.resource.data.approvalId is string && request.resource.data.approvalId.matches('^[a-zA-Z0-9_-]{1,128}$')
          && publicRoom(request.resource.data.roomId)
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)/approvals/$(request.resource.data.approvalId)).data.status == 'approved'
          && request.resource.data.status == 'queued' && request.resource.data.createdAt == request.time;
        allow update: if orgMember() && resource.data.status in ['queued','running']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled';
        allow delete: if false;
      }
    }
    match /rooms/{roomId} {
      allow read: if resource.data.get('orgId', '') == 'coco-co';
      allow create: if orgMember()
        && request.resource.data.keys().hasOnly(['title', 'ownerUid', 'orgId', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orgId == 'coco-co'
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if orgMember() && publicRoom(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
      allow delete: if false;
      match /updates/{updateId} {
        allow read: if publicRoom(roomId);
        allow create: if orgMember() && orgRoomAfter(roomId)
          && request.resource.data.keys().hasOnly(['bytes', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.bytes is bytes && request.resource.data.bytes.size() <= 262144
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if publicRoom(roomId);
        allow create: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 8000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /interviews/{entryId} {
        function pairedAnswer() {
          let message = getAfter(/databases/$(database)/documents/rooms/$(roomId)/messages/$(entryId)).data;
          return !exists(/databases/$(database)/documents/rooms/$(roomId)/messages/$(entryId))
            && message.authorUid == request.auth.uid
            && message.authorName == request.resource.data.authorName
            && message.text == request.resource.data.answer
            && message.createdAt == request.time;
        }
        allow read: if publicRoom(roomId);
        allow create: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['questionIndex', 'title', 'question', 'answer', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.questionIndex is int && request.resource.data.questionIndex >= 0 && request.resource.data.questionIndex <= 1000000
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
          && request.resource.data.question is string && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 2000
          && request.resource.data.answer is string && request.resource.data.answer.matches('(?s).*[^\\s].*') && request.resource.data.answer.size() <= 8000
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.createdAt == request.time
          && pairedAnswer();
        allow update, delete: if false;
      }
      match /presence/{presenceId} {
        allow read: if publicRoom(roomId);
        allow create, update: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'seenAt'])
          && request.resource.data.uid == request.auth.uid
          && (resource == null || resource.data.uid == request.auth.uid)
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.seenAt == request.time;
        allow delete: if orgMember() && publicRoom(roomId) && resource.data.uid == request.auth.uid;
      }
      match /cursors/{clientId} {
        allow read: if publicRoom(roomId);
        allow create, update: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['uid','bytes','seenAt'])
          && request.resource.data.uid == request.auth.uid
          && (resource == null || resource.data.uid == request.auth.uid)
          && request.resource.data.bytes is bytes && request.resource.data.bytes.size() <= 16384
          && request.resource.data.seenAt == request.time;
        allow delete: if orgMember() && publicRoom(roomId) && resource.data.uid == request.auth.uid;
      }
      match /approvals/{approvalId} {
        allow read: if publicRoom(roomId);
        allow create: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['approvedBy', 'plan', 'tasks', 'status', 'createdAt'])
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.plan is string && request.resource.data.plan.size() <= 200000
          && request.resource.data.tasks is list && request.resource.data.tasks.size() > 0 && request.resource.data.tasks.size() <= 100
          && request.resource.data.status == 'approved'
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /runs/{runId} {
        allow read: if publicRoom(roomId);
        allow write: if false;
      }
      match /steering/{noteId} {
        function activeRun() {
          return request.resource.data.runId is string
            && exists(/databases/$(database)/documents/rooms/$(roomId)/runs/$(request.resource.data.runId))
            && get(/databases/$(database)/documents/rooms/$(roomId)/runs/$(request.resource.data.runId)).data.status in ['running', 'paused'];
        }
        allow read: if publicRoom(roomId);
        allow create: if orgMember() && publicRoom(roomId)
          && request.resource.data.keys().hasOnly(['taskId', 'runId', 'text', 'timing', 'status', 'authorUid', 'authorName', 'createdAt'])
          && request.resource.data.taskId is string && request.resource.data.taskId.size() > 0 && request.resource.data.taskId.size() <= 200
          && (request.resource.data.runId == null || activeRun())
          && request.resource.data.text is string && request.resource.data.text.matches('(?s).*[^\\s].*') && request.resource.data.text.size() <= 4000
          && request.resource.data.timing in ['next', 'now']
          && (request.resource.data.timing == 'next' || (activeRun()
            && get(/databases/$(database)/documents/rooms/$(roomId)/runs/$(request.resource.data.runId)).data.status == 'running'))
          && request.resource.data.status == 'queued'
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.createdAt == request.time;
        // Members may cancel a queued request. Only the server acknowledges delivery.
        allow update: if orgMember() && publicRoom(roomId)
          && resource.data.status == 'queued' && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
